NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Required before registration/login works. Production startup fails without this.
JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
JWT_TTL_SECONDS=43200

# Strict CORS. Production must use explicit origins, never wildcard.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_SALES_EMAIL=sales@terrasignal.local

# Scan mode rules:
# live = no mock fallback; missing providers return unavailable
# mixed = live providers where available; missing providers remain unavailable
# internalDemo = deterministic mock indicators allowed, watermarked, client export blocked
SCAN_MODE=live
ALLOW_INTERNAL_DEMO=false

# Local JSON auth storage is for internal testing only.
TERRASIGNAL_USERS_PATH=data/users.json
TERRASIGNAL_SEED_ADMIN=false
TERRASIGNAL_ADMIN_EMAIL=admin@terrasignal.local
TERRASIGNAL_ADMIN_PASSWORD=ChangeMePilot123!

# Auth and scan abuse controls.
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_FAILED_LOGIN_LIMIT=5
AUTH_FAILED_LOGIN_WINDOW_MS=900000
AUTH_FAILED_LOGIN_LOCK_MS=900000
SCAN_RATE_LIMIT_MAX=40
SCAN_RATE_LIMIT_WINDOW_MS=600000
# Model-backed endpoints carry a per-call cost and get their own budget.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=600000
# Catch-all budget for every other API route.
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=600000
# Unauthenticated public pilot form.
PILOT_RATE_LIMIT_MAX=5
PILOT_RATE_LIMIT_WINDOW_MS=3600000

# Persistence. PostgreSQL is the default and only supported production store.
# There is no silent SQLite fallback: if PostgreSQL is unreachable the server
# refuses to start rather than writing to a different database than you expect.
#
# Supply credentials EITHER as a single URL:
#   DATABASE_URL=postgresql://user:password@127.0.0.1:5432/terrasignal
# OR as discrete variables (below). The URL wins if both are set.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=terrasignal
PGUSER=postgres
# Set once. The server never prompts. Leave empty only for trust/peer auth.
PGPASSWORD=
PGSSL=false

# DB_CLIENT overrides the default. Only the test suites set this, to "sqlite",
# so they can run against :memory: without a database server.
DB_CLIENT=
TERRASIGNAL_DB_PATH=data/terrasignal.sqlite

# Optional API key gate for backend endpoints.
TERRASIGNAL_API_KEY=

# Live geospatial provider integrations. Keep secret keys backend-side.
CESIUM_ION_TOKEN=
MAPBOX_ACCESS_TOKEN=
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DEM_TYPE=SRTMGL1
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_ELEVATION_DISABLED=false
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Fallback Overpass endpoints, rotated across retries when the primary sheds load.
OVERPASS_API_MIRRORS=
OVERPASS_MAX_ATTEMPTS=3

# Public geodata providers require a caller identity. Overpass returns HTTP 406
# without one, which silently degrades road/water/land-use indicators.
PROVIDER_USER_AGENT=

# Provider response cache. Keyed on rounded coordinate, radius and scan mode so
# multi-site portfolio work does not re-query the same point. 0 disables.
PROVIDER_CACHE_TTL_MS=900000

# Gemini analysis provider.
GEMINI_API_KEY=
# Free-tier request quota is per model, so switching model gives a fresh budget.
# gemini-3.5-flash gives the richest narrative; the flash-lite variants are
# faster and generally carry a higher free-tier allowance.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=12000
# Extended thinking is off by default: the deterministic engine has already done
# the reasoning, and thinking added around a minute per scan with no gain.
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_ATTEMPTS=3

# Public frontend-only keys. These are visible in the browser.
VITE_CESIUM_ION_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=
